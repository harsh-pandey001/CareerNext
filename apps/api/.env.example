# CareerNext API — environment template. Copy to `.env` and fill in.

NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.dev.yml service)
DATABASE_URL=postgresql://careernext:careernext@localhost:5432/careernext?schema=public
# Managed Postgres (Neon) serves a pooled and a direct host. Migrations need
# session state the pooler cannot provide, so Prisma uses DIRECT_URL for
# them and DATABASE_URL for everything else. Locally both are the same.
DIRECT_URL=postgresql://careernext:careernext@localhost:5432/careernext?schema=public

# JWT / Refresh tokens (V1 authentication)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# GraphQL
GRAPHQL_PLAYGROUND=true

# CORS — comma-separated allow-list (web app + trusted sibling frontends like the Resume Builder)
WEB_ORIGIN=http://localhost:3000,http://localhost:5173

# Auth cookies / reset tokens (optional — sane defaults if unset)
# COOKIE_DOMAIN=localhost
RESET_TOKEN_TTL_MIN=30

# Document storage — Cloudflare R2 (S3-compatible). Unset is tolerated at
# boot; document upload/download then fail with a clear error instead. Keep
# the bucket PRIVATE: files are served only via short-lived presigned URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=careernext-documents
# Presigned download URL lifetime, seconds (default 300).
R2_SIGNED_URL_TTL_SEC=300

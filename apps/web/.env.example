# CareerNext Web — environment template. Copy to `.env.local` and fill in.

# Public GraphQL endpoint exposed by apps/api
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# App metadata
NEXT_PUBLIC_APP_NAME=CareerNext
NEXT_PUBLIC_APP_ENV=development

# External Resume Builder app (opened from the Resume section; same-site SSO)
NEXT_PUBLIC_RESUME_BUILDER_URL=http://localhost:5173

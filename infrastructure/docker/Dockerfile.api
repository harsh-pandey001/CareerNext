# CareerNext API image (multi-stage) — activated in V3 (Docker).
# Built from the monorepo root so workspace packages resolve.
# Usage: docker build -f infrastructure/docker/Dockerfile.api .

# ---- deps ----
FROM node:20-alpine AS deps
# Prisma's engine-selection needs OpenSSL to detect the right binary target;
# without it here, `prisma generate` (postinstall below) silently defaults to
# the wrong target (openssl-1.1.x) instead of what Alpine actually has
# (openssl-3.0.x) — the engine then fails to load at runtime with a missing
# libssl.so.1.1 error.
RUN apk add --no-cache openssl
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/api/prisma apps/api/prisma
COPY packages ./packages
# apps/api's postinstall runs `prisma generate`, which needs both the schema
# (copied above — schema only, not the rest of the source, to keep this
# layer cache-friendly) and DATABASE_URL defined to parse it (it never
# connects to a real database at generate time). Other packages' own install
# scripts (e.g. bcrypt's native build) still run normally here.
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
RUN pnpm install --frozen-lockfile --filter @careernext/api...

# ---- build ----
FROM node:20-alpine AS build
RUN apk add --no-cache openssl
RUN corepack enable
WORKDIR /repo
COPY --from=deps /repo ./
COPY . .
# @careernext/api imports @careernext/shared-types (and @careernext/utils),
# which only exist as raw TS source until their own `build` script runs and
# produces dist/ — `pnpm --filter @careernext/api build` alone builds api
# ONLY. Use turbo so its `dependsOn: ["^build"]` pipeline builds those
# workspace deps first, same as `pnpm build` does at the repo root.
RUN pnpm --filter @careernext/api prisma:generate \
 && pnpm exec turbo run build --filter=@careernext/api

# ---- runtime ----
FROM node:20-alpine AS runtime
RUN apk add --no-cache openssl
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=build /repo ./
EXPOSE 4000
# WORKDIR is the monorepo root (not apps/api) — node_modules resolution for
# workspace deps (@careernext/shared-types etc.) needs the root node_modules
# tree alongside apps/api, so the whole /repo is copied in, not just apps/api.
CMD ["node", "apps/api/dist/main.js"]

# CareerNext Web image (multi-stage) — activated in V3 (Docker).
# Built from the monorepo root so workspace packages resolve.
# Usage: docker build -f infrastructure/docker/Dockerfile.web .

# ---- deps ----
FROM node:20-alpine AS deps
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @careernext/web...

# ---- build ----
FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY --from=deps /repo ./
COPY . .
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so they
# must be passed as build args here — setting them at container runtime (in
# docker-compose's `environment:`) has no effect on an already-built bundle.
ARG NEXT_PUBLIC_GRAPHQL_ENDPOINT
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_GRAPHQL_ENDPOINT=$NEXT_PUBLIC_GRAPHQL_ENDPOINT \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
RUN pnpm --filter @careernext/web build

# ---- runtime ----
# next.config.mjs sets `output: 'standalone'`, which traces and copies only
# the files actually needed to run (plus a minimal node_modules) instead of
# the whole monorepo checkout — shrinks this image from ~1.5GB to ~150MB.
# Static assets and public/ aren't included in standalone output by design
# (see Next.js docs) and must be copied in separately.
FROM node:20-alpine AS runtime
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /repo
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

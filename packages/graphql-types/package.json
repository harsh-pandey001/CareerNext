{
  "name": "@careernext/graphql-types",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL Code Generator output shared between the API schema and web/mobile clients.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo src/generated"
  },
  "devDependencies": {
    "@careernext/typescript-config": "workspace:*",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.1",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "graphql": "^16.9.0"
  }
}

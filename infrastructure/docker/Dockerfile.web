# CareerNext Web image (multi-stage) — activated in V3 (Docker).
# Built from the monorepo root so workspace packages resolve.
# Usage: docker build -f infrastructure/docker/Dockerfile.web .

# ---- deps ----
FROM node:20-alpine AS deps
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @careernext/web...

# ---- build ----
FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY --from=deps /repo ./
COPY . .
RUN pnpm --filter @careernext/web build

# ---- runtime ----
FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /repo/apps/web
COPY --from=build /repo ./
EXPOSE 3000
CMD ["pnpm", "start"]

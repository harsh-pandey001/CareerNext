// CareerNext — Prisma schema (PostgreSQL).
//
// This baseline models the V1 domain. Feature work fills in relations and
// adds the V2 interview flow. Domain enums mirror `@careernext/shared-types`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  SAVED
  APPLIED
  OA_SCHEDULED
  INTERVIEW_ROUND_1
  INTERVIEW_ROUND_2
  HR_ROUND
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
}

enum DocumentType {
  RESUME
  CERTIFICATE
  OFFER_LETTER
  EXPERIENCE_LETTER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InterviewRound {
  ONLINE_ASSESSMENT
  TECHNICAL_ROUND_1
  TECHNICAL_ROUND_2
  HR_ROUND
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
}

enum NotificationType {
  APPLICATION_STATUS_CHANGED
  INTERVIEW_REMINDER
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole @default(USER)
  isEmailVerified Boolean  @default(false)

  profile             Profile?
  applications        Application[]
  documents           Document[]
  resumeVersions      ResumeVersion[]
  skills              Skill[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  customJobs          Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Profile {
  id                   String  @id @default(uuid())
  userId               String  @unique
  headline             String?
  bio                  String?
  location             String?
  githubUrl            String?
  linkedinUrl          String?
  portfolioUrl         String?
  completionPercentage Int     @default(0)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations  Education[]
  experiences Experience[]
  languages   Language[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Education {
  id           String    @id @default(uuid())
  profileId    String
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  grade        String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("educations")
}

model Experience {
  id          String    @id @default(uuid())
  profileId   String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("experiences")
}

model Language {
  id          String              @id @default(uuid())
  profileId   String
  name        String
  proficiency LanguageProficiency

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("languages")
}

model Skill {
  id                String     @id @default(uuid())
  userId            String
  name              String
  level             SkillLevel
  yearsOfExperience Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("skills")
}

model Job {
  id          String   @id @default(uuid())
  title       String
  company     String
  location    String?
  description String
  type        JobType
  workMode    WorkMode
  salaryMin   Int?
  salaryMax   Int?
  externalUrl String?
  skills      String[] @default([])

  // Null = part of the shared/seeded catalog, visible to everyone. Set =
  // a user's own externally-sourced application, private to them — the
  // `jobs` query filters these out, `myCustomJobs` returns only these.
  createdById        String?
  experienceRequired String?
  contactEmail       String?

  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([workMode])
  @@index([createdById])
  @@map("jobs")
}

model Application {
  id       String            @id @default(uuid())
  userId   String
  jobId    String
  status   ApplicationStatus @default(SAVED)
  notes    String?
  appliedAt DateTime?

  // Manually entered for now (mainly on custom/externally-sourced jobs) —
  // future home for AI-generated drafts built from the user's resume + the
  // job's description, once that lands.
  coverLetter String?
  pitchEmail  String?

  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  statusHistory ApplicationStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@map("applications")
}

// One row per status transition (including the initial SAVED/APPLIED on
// creation, where fromStatus is null) — the raw material for Sprint 4's
// funnel/conversion analytics. Written atomically alongside every status
// change in ApplicationsService, never edited after the fact.
model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_history")
}

// V2 Interview Tracker. Interviews hang off an Application (the userId is
// denormalized for cheap ownership checks + the dashboard's "upcoming"
// query, which spans all of a user's applications).
model Interview {
  id            String           @id @default(uuid())
  applicationId String
  userId        String
  round         InterviewRound
  scheduledAt   DateTime?
  outcome       InterviewOutcome @default(PENDING)
  notes         String?
  // Set once the 24h-before reminder notification has been sent for this
  // interview — the cron job's dedup key, so it never double-notifies on
  // its next scan even if the interview stays PENDING.
  reminderSentAt DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([userId, scheduledAt])
  @@map("interviews")
}

// A user-facing feed entry — application status changes and interview
// reminders today, extensible to more types later. `link` is an in-app
// path (not a full URL) since this is always consumed by our own frontend.
model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String
  message String
  link    String?
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Document {
  id       String       @id @default(uuid())
  userId   String
  type     DocumentType
  fileName String
  // Raw file bytes, stored directly in Postgres — V3 brings AWS S3 (see
  // CLAUDE.md's roadmap); this column becomes a `fileUrl` pointing at S3
  // then, without changing the GraphQL contract (DocumentModel.fileUrl is
  // already a lazily-resolved field, computed as a data: URL for now).
  fileData Bytes
  fileSize Int
  mimeType String

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("documents")
}

// A resume upload is a Document (type = RESUME) plus this versioning
// envelope — keeps "which resume is currently active" and version numbering
// as Resume-specific concerns, separate from the generic Documents vault.
model ResumeVersion {
  id         String  @id @default(uuid())
  documentId String  @unique
  userId     String
  version    Int
  isActive   Boolean @default(false)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Version numbers are computed (max + 1) inside the upload transaction —
  // this constraint turns a concurrent-upload race into a clean error
  // instead of silently persisting two identical version numbers.
  @@unique([userId, version])
  @@index([userId])
  @@map("resume_versions")
}
